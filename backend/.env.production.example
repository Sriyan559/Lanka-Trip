APP_NAME=EcomLanka
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Colombo

FRONTEND_URL=https://example.com
SANCTUM_STATEFUL_DOMAINS=example.com
SANCTUM_TOKEN_PREFIX=ecomlanka_

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecomlanka
DB_USERNAME=ecomlanka
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
HORIZON_PREFIX=ecomlanka_horizon:

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=EcomLanka

L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_USE_ABSOLUTE_PATH=true
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.0.0

BACKUP_ARCHIVE_PASSWORD=
BACKUP_NAME=EcomLanka
BACKUP_NOTIFICATION_EMAIL=
